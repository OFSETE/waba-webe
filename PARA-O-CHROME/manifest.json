{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "WABA WEBE",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "pt_BR",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://web.whatsapp.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "wa-config.js",
        "vendor/wppconnect-wa.js",
        "page.js"
      ],
      "matches": [
        "*://web.whatsapp.com/*"
      ]
    }
  ]
}